 * ║  🔒 FIX F-20: اختبارات توحيد كلمات المرور على argon2id (F-21)                  ║
 * ║  تُرسّخ: تجزئة argon2id، الكشف التلقائي للنوع، الهجرة الشفافة من bcrypt،       ║
 * ║  والرفض الآمن للمدخلات التالفة.                                                ║
 * ╚═══════════════════════════════════════════════════════════════════════════════╝
 */
import {
  hashPassword,
  verifyPassword,
  needsRehash,
  isArgon2Hash,
  isBcryptHash,
} from '@common/utils/password.util';
import * as bcrypt from 'bcryptjs';

describe('Password Util — argon2id (F-21)', () => {
  describe('hashPassword', () => {
    it('ينتج hash بصيغة argon2id', async () => {
      const hash = await hashPassword('MySecret#2024');
      expect(hash.startsWith('$argon2id$')).toBe(true);
      expect(isArgon2Hash(hash)).toBe(true);
    });

    it('ينتج hashes مختلفة لنفس كلمة المرور (salt عشوائي)', async () => {
      const h1 = await hashPassword('same-password');
      const h2 = await hashPassword('same-password');
      expect(h1).not.toBe(h2);
    });
  });

  describe('verifyPassword — argon2', () => {
    it('يتحقق من كلمة المرور الصحيحة', async () => {
      const hash = await hashPassword('correct-horse');
      expect(await verifyPassword('correct-horse', hash)).toBe(true);
    });

    it('يرفض كلمة المرور الخاطئة', async () => {
      const hash = await hashPassword('correct-horse');
      expect(await verifyPassword('wrong-horse', hash)).toBe(false);
    });
  });

  describe('verifyPassword — bcrypt (توافق خلفي أثناء الهجرة)', () => {
    it('يتحقق من hash قديم بصيغة bcrypt', async () => {
      const legacy = bcrypt.hashSync('legacy-pass', 12);
      expect(isBcryptHash(legacy)).toBe(true);
      expect(await verifyPassword('legacy-pass', legacy)).toBe(true);
    });

    it('يرفض كلمة مرور خاطئة على hash bcrypt', async () => {
      const legacy = bcrypt.hashSync('legacy-pass', 12);
      expect(await verifyPassword('nope', legacy)).toBe(false);
    });
  });

  describe('needsRehash — الهجرة الشفافة', () => {
    it('يطلب إعادة التجزئة لـ hash bcrypt القديم', () => {
      const legacy = bcrypt.hashSync('x', 10);
      expect(needsRehash(legacy)).toBe(true);
    });

    it('لا يطلب إعادة التجزئة لـ hash argon2 حديث', async () => {
      const modern = await hashPassword('x');
      expect(needsRehash(modern)).toBe(false);
    });

    it('دورة الهجرة الكاملة: bcrypt → verify → rehash → argon2', async () => {
      const pwd = 'merchant-secret';
      let stored = bcrypt.hashSync(pwd, 12);
      // دخول أول: يتحقق عبر bcrypt
      expect(await verifyPassword(pwd, stored)).toBe(true);
      // يحتاج ترقية
      expect(needsRehash(stored)).toBe(true);
      stored = await hashPassword(pwd);
      // بعد الترقية: argon2، لا حاجة لإعادة
      expect(isArgon2Hash(stored)).toBe(true);
      expect(needsRehash(stored)).toBe(false);
      // دخول ثانٍ: يتحقق عبر argon2
      expect(await verifyPassword(pwd, stored)).toBe(true);
    });
  });

  describe('الحالات الحدّية — رفض آمن بلا انهيار', () => {
    it('يرفض hash فارغ', async () => {
      expect(await verifyPassword('x', '')).toBe(false);
    });

    it('يرفض hash null/undefined', async () => {
      expect(await verifyPassword('x', null as unknown as string)).toBe(false);
      expect(await verifyPassword('x', undefined as unknown as string)).toBe(false);
    });

    it('يرفض hash بصيغة غير معروفة', async () => {
      expect(await verifyPassword('x', 'not-a-real-hash')).toBe(false);
    });

    it('يرفض hash argon2 تالف دون رمي استثناء', async () => {
      expect(await verifyPassword('x', '$argon2id$corrupted')).toBe(false);
    });
  });
});
